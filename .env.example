# Copie para .env antes de subir o ambiente:  cp .env.example .env
# O .env NAO vai para o git.

# --- Banco de dados ---
POSTGRES_USER=ponto
POSTGRES_PASSWORD=ponto
POSTGRES_DB=ponto_facial
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
ENVIRONMENT=local
DEBUG=true
DB_ECHO=false

# --- Seguranca (Etapa 2) ---
# Em producao, gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-nao-use-em-producao
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Reconhecimento facial ---
# stub = sem modelo, deterministico. A engine real exige a imagem
# Dockerfile.facial (ver docker-compose.facial.yml).
FACE_ENGINE=stub
FACE_MATCH_THRESHOLD=0.40
FACE_REVIEW_THRESHOLD=0.32
FACE_MIN_ENROLLMENT_IMAGES=3
FACE_MAX_ENROLLMENT_IMAGES=5

# --- Armazenamento de imagens ---
STORAGE_PATH=/app/storage
# Chave AES-256 (32 bytes em base64) para as imagens de rosto em repouso.
# ESTA CHAVE E SO PARA DESENVOLVIMENTO. Em producao, gere uma nova e guarde no
# gerenciador de segredos da plataforma:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Perder a chave torna as imagens ja gravadas irrecuperaveis.
STORAGE_ENCRYPTION_KEY=ZGVzZW52b2x2aW1lbnRvLWFwZW5hcy1uYW8tdXNlISE=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
