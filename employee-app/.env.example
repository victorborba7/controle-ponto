# Copie para .env antes de compilar:  cp .env.example .env
#
# Endereco do backend. EXPO_PUBLIC_ e obrigatorio: e o prefixo que o Expo
# embute no bundle. Como o valor vai dentro do APK, aqui nao entra segredo
# nenhum — so a URL publica da API.
#
# Em desenvolvimento com aparelho fisico, use o IP da maquina na rede local
# (localhost aponta para o proprio celular). Descubra com `ipconfig`.
EXPO_PUBLIC_API_URL=http://192.168.3.27:8000
